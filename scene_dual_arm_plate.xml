<?xml version="1.0" encoding="utf-8"?>
<!--
  轮式移动双臂机器人协同稳载仿真场景
  项目：BalanceDual-Arm
  版本：v1.0 | 日期：2026-07-31

  使用方式：
    直接将 KITT1_5V3 机器人模型和场景物体合并在一个文件中，
    避免 MuJoCo include 路径问题。

  场景物体（全部原生几何体）：
    - 地面（plane）
    - 平板 mocap 驱动体 + 平板物理浮体（weld 约束连接）
    - 水杯自由刚体
    - 水体质量块（模拟水面重心偏移）
    - 自由滚动小球

  执行器规则：
    - 全部关节使用 motor 力矩型执行器
    - 禁止直接写 qpos 赋值控制机器人（初始化除外）
    - 控制通过 data.ctrl 写入力矩
-->
<mujoco model="dual_arm_plate_scene">

  <compiler angle="radian"/>

  <!-- ================================================================ -->
  <!-- 仿真选项 -->
  <!-- ================================================================ -->
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast">
    <flag contact="enable" gravity="enable" energy="enable"/>
  </option>

  <visual>
    <global offwidth="1920" offheight="1080" azimuth="135" elevation="-20"/>
  </visual>

  <default>
    <geom solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <default class="env">
      <geom contype="0" conaffinity="0" group="3"/>
    </default>
    <default class="collision">
      <geom group="2"/>
    </default>
  </default>

  <!-- ================================================================ -->
  <!-- 网格资源（机器人 + 可选高精度模型） -->
  <!-- ================================================================ -->
  <asset>
    <!-- ===== 机器人 STL 网格（58个） ===== -->
    <mesh name="YD_link"       content_type="model/stl" file="KITT1_5V3robot_dual_dahuan_urdf/YD_link.STL"/>
