    <geom pos="0.32715 -0.181305 0.228585" quat="0.575516 0.575516 0.41083 0.41083" type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="C3_Link" contype="2" conaffinity="31"/>
    <geom pos="0.32715 0.181305 0.228585" quat="0.41083 0.41083 0.575516 0.575516" type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="C4_Link" contype="2" conaffinity="31"/>
    <geom pos="0.173974 0.2725 0.228585" quat="0 0 0.707107 0.707107" type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="C5_Link" contype="2" conaffinity="31"/>
    <geom pos="-0.173909 0.2725 0.228959" quat="0 0 -0.707107 -0.707107" type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="C6_Link" contype="2" conaffinity="31"/>
    <geom pos="-0.321195 0.172186 0.228581" quat="0.459049 0.459049 -0.537842 -0.537842" type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="C7_Link" contype="2" conaffinity="31"/>
    <geom pos="-0.321195 -0.172186 0.228581" quat="0.537842 0.537842 -0.459049 -0.459049" type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="C8_Link" contype="2" conaffinity="31"/>
    <geom pos="0 0 0.1" quat="1 0 0 0" type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="IMU_Link" contype="2" conaffinity="31"/>
    <geom pos="0.34185 0.0175 0.199" quat="0.499998 0.5 0.500002 0.5" type="mesh" rgba="0.86667 0.9098 1 1" mesh="XJ_Link" contype="2" conaffinity="31"/>
    <geom pos="0.1 0 0.062" quat="1 0 0 0" type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="Trunk_base" contype="2" conaffinity="31"/>

    <!-- == 左前腿 (ZQ → ZQL) == -->
    <body name="ZQ_Link" pos="0.230716 0.217384 0.206001">
      <inertial pos="-0.000669849 -0.0241901 -0.0616279" quat="0.663864 -0.25099 0.249538 0.658801" mass="0.649768" diaginertia="0.000791176 0.00076148 0.000312348"/>
      <joint name="ZQ" axis="0 0 -1"/>
      <geom type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="ZQ_Link"/>
      <body name="ZQL_Link" pos="-0.000716532 0.000616031 -0.136" quat="0.707107 0.707107 0 0">
        <inertial pos="-2.43385e-06 2.85294e-06 0.000784617" quat="0.013698 0.706959 -0.0135967 0.706991" mass="1.22319" diaginertia="0.00376745 0.00205205 0.00205173"/>
        <joint name="ZQL" axis="0 0 1"/>
        <geom type="mesh" rgba="0.25098 0.25098 0.25098 1" mesh="ZQL_Link"/>
      </body>
    </body>

    <!-- == 右前腿 (YQ → YQL) == -->
    <body name="YQ_Link" pos="0.229283 -0.217384 0.206001">
      <inertial pos="0.000669849 0.0241901 -0.0616279" quat="0.663864 0.25099 -0.249538 0.658801" mass="0.649768" diaginertia="0.000791176 0.00076148 0.000312348"/>
      <joint name="YQ" axis="0 0 -1"/>
      <geom type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="YQ_Link"/>
      <body name="YQL_Link" pos="0.000716532 -0.000616031 -0.136" quat="0 0 0.707107 0.707107">
        <inertial pos="-2.43385e-06 2.85294e-06 0.000784617" quat="0.013698 0.706959 -0.0135967 0.706991" mass="1.22319" diaginertia="0.00376745 0.00205205 0.00205173"/>
        <joint name="YQL" axis="0 0 1"/>
        <geom type="mesh" rgba="0.25098 0.25098 0.25098 1" mesh="YQL_Link"/>
      </body>
    </body>

    <!-- == 左后腿 (ZH → ZHL) == -->
    <body name="ZH_Link" pos="-0.229284 0.217384 0.205999">
      <inertial pos="-0.000669849 -0.0241901 -0.0616279" quat="0.663864 -0.25099 0.249538 0.658801" mass="0.649768" diaginertia="0.000791176 0.00076148 0.000312348"/>
      <joint name="ZH" axis="0 0 -1"/>
      <geom type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="ZH_Link"/>
