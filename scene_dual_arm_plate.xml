    <mesh name="cam_install_rightarm" content_type="model/stl" file="KITT1_5V3robot_dual_dahuan_urdf/cam_install_rightarm.STL"/>
    <mesh name="Rbase_link"          content_type="model/stl" file="KITT1_5V3robot_dual_dahuan_urdf/Rbase_link.STL"/>
    <mesh name="rightfinger1_Link"   content_type="model/stl" file="KITT1_5V3robot_dual_dahuan_urdf/rightfinger1_Link.STL"/>
    <mesh name="rightfinger2_Link"   content_type="model/stl" file="KITT1_5V3robot_dual_dahuan_urdf/rightfinger2_Link.STL"/>
    <mesh name="left_flange_link"    content_type="model/stl" file="KITT1_5V3robot_dual_dahuan_urdf/left_flange_link.STL"/>
    <mesh name="cam_install_leftarm" content_type="model/stl" file="KITT1_5V3robot_dual_dahuan_urdf/cam_install_leftarm.STL"/>
    <mesh name="Lbase_link"          content_type="model/stl" file="KITT1_5V3robot_dual_dahuan_urdf/Lbase_link.STL"/>
    <mesh name="leftfinger1_Link"    content_type="model/stl" file="KITT1_5V3robot_dual_dahuan_urdf/leftfinger1_Link.STL"/>
    <mesh name="leftfinger2_Link"    content_type="model/stl" file="KITT1_5V3robot_dual_dahuan_urdf/leftfinger2_Link.STL"/>
  </asset>

  <!-- ================================================================ -->
  <!-- 世界体（机器人 + 场景物体） -->
  <!-- ================================================================ -->
  <worldbody>

    <!-- ===== 光照 ===== -->
    <light name="sun" directional="true" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"
           pos="5 0 8" dir="-0.4 0 -1"/>
    <light name="fill" directional="true" diffuse="0.4 0.4 0.4"
           pos="-3 -3 3" dir="0.5 0.5 -1"/>

    <!-- ===== 地面 ===== -->
    <geom type="plane" size="3 3 0.1" rgba="0.30 0.35 0.42 1"/>
    <geom type="box" pos="1 0 -0.005" size="1.5 0.02 0.005" rgba="0.85 0.85 0.85 0.4"/>
    <geom type="box" pos="1 0 -0.005" size="0.02 1.5 0.005" rgba="0.85 0.85 0.85 0.4"/>

    <!-- ============================================================= -->
    <!-- 场景物体：平板 Mocap 驱动体（不受物理影响，程序直接设位姿） -->
    <!-- 平板尺寸: 半尺寸 0.21(长) × 0.12(短) × 0.008(厚) -->
    <!-- 绕Z轴旋转90°后：长边沿Y(±0.21)正对机器人，短边在左右 -->
    <!-- 左右夹爪水平侧向夹持短边，手指开合沿Z夹住板厚，避免穿模 -->
    <!-- ============================================================= -->
    <body name="plate_mocap" mocap="true" pos="0.35 0 0.98">
      <geom type="box" size="0.21 0.12 0.008" rgba="0.82 0.55 0.15 0.18" 
            contype="0" conaffinity="0"/>
    </body>

    <!-- ============================================================= -->
    <!-- 场景物体：实际平板物理浮体（weld 约束跟随 mocap） -->
    <!-- ============================================================= -->
    <body name="plate" pos="0.35 0 0.98">
      <freejoint name="plate_freejoint"/>
      <!-- 平板主体：半尺寸 0.21×0.12，旋转90°后长边沿Y(±0.21)，短边沿X -->
      <geom type="box" size="0.21 0.12 0.008" mass="0.80"
            rgba="0.82 0.55 0.15 1" name="plate_geom"
            friction="5 0.1 0.01" condim="4"
            solref="0.004 1" solimp="0.95 0.99 0.001 0.5 2"/>
      <!-- 方向标记 -->
      <geom type="box" pos="0.19 0 0" size="0.012 0.02 0.005" rgba="0 1 0 1" contype="0" conaffinity="0"/>
      <geom type="box" pos="0 0.10 0" size="0.03 0.01 0.005"  rgba="0 0 1 1" contype="0" conaffinity="0"/>
      <!-- 板面中心标记点 -->
      <site name="plate_center" type="sphere" size="0.01" rgba="1 1 0 0.8"/>

    </body>

    <!-- ============================================================= -->
    <!-- 水杯（自由浮体，放置在平板右侧） -->
    <!-- freejoint 必须是 worldbody 的直接子体 -->
    <!-- ============================================================= -->
    <body name="cup" pos="0.455 0.08 0.96">
      <freejoint name="cup_freejoint"/>
      <geom type="box" size="0.04 0.04 0.05" mass="0.15"
            rgba="0.15 0.55 0.85 0.85" name="cup_geom"/>
      <geom type="box" pos="0 0 0.04"  size="0.035 0.035 0.002" rgba="0.20 0.60 0.90 0.5"/>
      <geom type="box" pos="0 0 -0.04" size="0.035 0.035 0.002" rgba="0.10 0.40 0.70 0.5"/>
    </body>

    <!-- ============================================================= -->
    <!-- 水体质量块（自由浮体，悬浮于水杯内） -->
    <!-- 模拟水面重心偏移：小质量刚体靠接触力停留在杯内 -->
    <!-- ============================================================= -->
    <body name="water_mass" pos="0.455 0.08 0.985">
      <freejoint name="water_freejoint"/>
      <geom type="box" size="0.030 0.030 0.018" 
            rgba="0.25 0.60 0.95 0.45" mass="0.10" name="water_geom"/>
    </body>

    <!-- ============================================================= -->
    <!-- 自由滚动小球（自由浮体，放置在平板左侧） -->
    <!-- ============================================================= -->
    <body name="ball" pos="0.355 -0.08 0.93">
      <freejoint name="ball_freejoint"/>
      <geom type="sphere" size="0.02" rgba="0.95 0.25 0.25 1" mass="0.05" name="ball_geom"/>
      <geom type="cylinder" size="0.004 0.028" rgba="1 1 1 0.5" zaxis="0 0 1" contype="0" conaffinity="0"/>
      <site name="ball_site" type="sphere" size="0.005" rgba="1 1 1 1"/>
    </body>

    <!-- ============================================================= -->
    <!-- 机器人本体（KITT1_5V3 双足双臂人形机器人） -->
    <!-- 
      运动学树：
        世界 (worldbody)
          ├── plate_mocap (mocap 驱动体, 无物理)
          ├── plate (free 浮体, 通过 weld 跟随 mocap)
          ├── cup (free 浮体, 在平板上方右侧)
          ├── water_mass (free 浮体, 在水杯内部)
          ├── ball (free 浮体, 在平板上方左侧)
          └── [腿×4] → Trunk1 → Trunk2 → Trunk3 → Trunk4
                  ├── Joint1_L → ... → Joint7_L (左臂 TCP)
                  │       └── leftfinger1, leftfinger2
                  ├── Joint1_R → ... → Joint7_R (右臂 TCP)
                  │       └── rightfinger1, rightfinger2
                  └── Head1 → Head2
        
      关节 DOF 地址映射（按 XML 出现顺序）：
        0-7:   腿关节 (ZQ, ZQL, YQ, YQL, ZH, ZHL, YH, YHL)
        8-11:  躯干关节 (trunk_joint_1~4)
        12-18: 左臂关节 (left_arm_joint_1~7)
        19:    左手指1 (leftfinger1_joint)
        20:    左手指2 (leftfinger2_joint)
        21-27: 右臂关节 (right_arm_joint_1~7)
        28:    右手指1 (rightfinger1_joint)
        29:    右手指2 (rightfinger2_joint)
        30-31: 头部 (head_joint_1~2)
        32-38: 平板 free joint (3 pos + 4 quat)
        39-45: 水杯 free joint
        46-52: 水体 free joint
        53-59: 小球 free joint
        
        总计：32 个机器人关节 DOF + 4×7=28 个自由刚体 DOF = 60 DOF
    -->
    <!-- ============================================================= -->

    <!-- == 世界级静态几何 == -->
    <geom type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="YD_link" contype="2" conaffinity="31"/>
    <geom pos="0.220969 0.2007 0.366024" quat="0.255976 0.109346 0.0382559 0.959717" type="mesh" rgba="0.866667 0.866667 0.890196 1" mesh="ZLD_Link" contype="2" conaffinity="31"/>
