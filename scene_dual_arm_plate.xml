    </body>

    <!-- == 右后腿 (YH → YHL) == -->
    <body name="YH_Link" pos="-0.230717 -0.217384 0.205999">
      <inertial pos="0.000669849 0.0241901 -0.0616279" quat="0.663864 0.25099 -0.249538 0.658801" mass="0.649768" diaginertia="0.000791176 0.00076148 0.000312348"/>
